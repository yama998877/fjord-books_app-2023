<h2><%= t(Comment.model_name.human.downcase) %></h2>
<% commentable.comments.each do |c| %>
  <% unless c.created_at.nil? %>
    <p><hr><%= name_or_email(c) %> |
    <%= Comment.human_attribute_name(:comment_time) %>[<%= l(c.created_at, format: :long) %>]<br>
    <strong>
      <%= t(Comment.model_name.human.downcase) %>:
    </strong>
    <%= c.body %>
    <% if current_user == c.user %>
      <%= button_to t('views.common.destroy', name: Comment.model_name.human.downcase), polymorphic_path([commentable, c]), method: :delete %></p>
    <% end %>
  <% end %>
<% end %>
