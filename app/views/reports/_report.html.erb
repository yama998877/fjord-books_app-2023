<div id="<%= dom_id report %>">

  <p>
    <strong><%= Report.human_attribute_name(:title) %>:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:post_time) %>:</strong>
    <%= l(report.created_at, format: :long ) %>
  </p>

  <p>
    <strong><%= User.model_name.human %>:</strong>
    <%= name_or_email(report) %>
  </p>

  <p>
    <strong><%= Report.human_attribute_name(:body) %>:</strong>
    <%= report.body %>
  </p>

</div>
