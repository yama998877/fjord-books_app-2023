<!DOCTYPE html>
<html>
  <head>
    <title>BooksApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= params[:action] %>">
    <p>
      <% if user_signed_in? %>
        <strong><%= current_user.email %></strong><%= t('user.login') %><br>
        <%= link_to t('user.edit', resource: User.model_name.human), edit_user_registration_path %> |
        <%= link_to t('users.list', resource: User.model_name.human), users_path %> |
        <%= link_to t('user.logout'), destroy_user_session_path, data: { turbo_method: :delete } %>
      <% end %>
    </p>
    <p class="notice" style="color: green"><%= notice %></p>
    <p class="alert" style="color: red"><%= alert %></p>
    <%= yield %>
  </body>
</html>
